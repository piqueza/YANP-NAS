# YANP Nas: dedicated snapshot receiver, does not modify the main SSH service.
[Unit]
Description=YANP Nas Btrfs snapshot SSH receiver
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
RuntimeDirectory=yanp-snapshot-sshd
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/install -d -m 0755 /run/sshd
ExecStartPre=/usr/sbin/sshd -t -f /etc/yanp-snapshot-ssh/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/yanp-snapshot-ssh/sshd_config
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=30
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
# sshd must switch UID, and the fixed sudo helper needs privilege for receive.
# Do not enable NoNewPrivileges or PrivateDevices here.

[Install]
WantedBy=multi-user.target
